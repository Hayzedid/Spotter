# Local development
DJANGO_DEBUG=True

# OpenRouteService key for truck (HGV) routing. Free at https://openrouteservice.org/dev/#/signup
# Without it the app falls back to OSRM car routing and says so in the UI.
ORS_API_KEY=your_openrouteservice_api_key_here

# Production only (set in the hosting dashboard, not in this file)
# SECRET_KEY=long-random-string
# DJANGO_ALLOWED_HOSTS=your-backend.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.netlify.app
